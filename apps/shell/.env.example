# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Base URL (including /api/v1) of the ecommerce-mf API — the Railway
# deployment in production. Read by apps/shell/webpack.prod.config.ts and
# baked into the browser bundle at build time via webpack's DefinePlugin, so
# it must be set as a Vercel project Environment Variable, not a runtime file.
#
# If left unset, the app falls back to same-origin (`${window.location.origin}/api/v1`)
# when not running on localhost, or http://localhost:3000/api/v1 for local dev.
# On a standalone Vercel deployment (its own domain, separate from the API)
# this fallback is wrong, so set it explicitly there.
NX_PUBLIC_API_BASE_URL=https://your-api.up.railway.app/api/v1

# ---------------------------------------------------------------------------
# Module Federation remotes
# ---------------------------------------------------------------------------
# Base origin of each remote micro-frontend's own Vercel deployment — no
# trailing slash and no /remoteEntry.mjs suffix, Nx appends that itself.
# Read by apps/shell/webpack.prod.config.ts at build time to wire up the
# remotes array; without these, shell won't find product/cart/auth at runtime.
NX_PUBLIC_PRODUCT_REMOTE_URL=https://your-product-app.vercel.app
NX_PUBLIC_CART_REMOTE_URL=https://your-cart-app.vercel.app
NX_PUBLIC_AUTH_REMOTE_URL=https://your-auth-app.vercel.app
