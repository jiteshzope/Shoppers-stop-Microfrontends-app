# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Comma separated list of browser origins allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:4200

# Database
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/ecommerce

# Session cookies. Sessions are opaque random tokens stored as SHA-256 digests,
# so there is no signing secret to configure.
SESSION_TTL_HOURS=24
# Set to true whenever the API is served over HTTPS.
COOKIE_SECURE=false
# lax | strict | none ("none" requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
