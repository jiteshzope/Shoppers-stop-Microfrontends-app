# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Comma separated list of browser origins allowed to send credentialed requests.
# Every micro-frontend origin that talks to this API has to be listed here.
CORS_ORIGIN=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:4203

# Origin the browser reaches this API on. Product rows store image paths, and
# this is what turns them into links the storefront can load.
PUBLIC_BASE_URL=http://localhost:3000

# Serve the OpenAPI explorer at /docs. Leave off in production unless the API
# is meant to be publicly documented.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Database — a Neon connection string in deployed environments
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://app_user:app_password@localhost:5433/ecommerce

# ---------------------------------------------------------------------------
# Authentication
#
# Two independent secrets so a leaked access-token secret cannot be used to mint
# refresh tokens. Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_TTL=7d

# Refresh tokens are also mirrored into an httpOnly cookie so a browser client
# can hold them out of reach of JavaScript.
# Set COOKIE_SECURE=true and COOKIE_SAME_SITE=none when the API and the
# storefront live on different origins over HTTPS (the Railway/Vercel setup).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Rate limiting (per IP)
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Tighter budget for the credential endpoints (login / register / refresh).
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10
